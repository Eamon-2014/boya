/* components/notification-toast/notification-toast.wxss */
.notification-toast-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  padding: 20rpx 24rpx;
  /* 初始状态：在屏幕上方之外 */
  transform: translateY(-120rpx);
  opacity: 0;
}

.toast-inner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1F2937 0%, #374151 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.25);
  border-left: 8rpx solid #3B82F6;
}

.toast-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.toast-content {
  flex: 1;
  overflow: hidden;
}

.toast-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.toast-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 6rpx;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
