/* components/search-bar/search-bar.wxss */
.search-bar {
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 32rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.search-bar-icon {
  width: 32rpx;
  height: 32rpx;
  color: #9CA3AF;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-bar-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1F2937;
  background: transparent;
}

.search-bar-input::placeholder {
  color: #9CA3AF;
}

.search-bar-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1;
  margin-left: 16rpx;
}

.search-bar-action {
  padding-left: 24rpx;
  margin-left: 16rpx;
  border-left: 1rpx solid #F3F4F6;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 500;
}
