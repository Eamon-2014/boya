/* pages/questionnaire-analysis/questionnaire-analysis.wxss */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 0 32rpx;
  padding-top: 24rpx;
  padding-bottom: 64rpx;
  box-sizing: border-box;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9CA3AF;
}

/* 概览网格 */
.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.overview-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border-left: 6rpx solid;
  display: flex;
  flex-direction: column;
}

.card-blue { border-left-color: var(--color-primary-light); }
.card-green { border-left-color: #10B981; }
.card-orange { border-left-color: #F59E0B; }
.card-purple { border-left-color: #8B5CF6; }

.overview-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.overview-label {
  font-size: 24rpx;
  color: #6B7280;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 24rpx;
}

.filter-header {
  margin-bottom: 16rpx;
}

/* 模板筛选 */
.template-filter {
  white-space: nowrap;
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.filter-item {
  display: inline-block;
  padding: 16rpx 28rpx;
  background: #F3F4F6;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6B7280;
  transition: all 0.2s;
  flex-shrink: 0;
}

.filter-item.active {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-weight: 600;
}

/* 模板统计卡片列表 */
.template-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.template-stat-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
}

.template-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.template-info {
  flex: 1;
  min-width: 0;
}

.template-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 12rpx;
}

.template-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.lang-tag {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.template-questions {
  font-size: 22rpx;
  color: #9CA3AF;
}

.template-arrow {
  font-size: 36rpx;
  color: #9CA3AF;
  margin-left: 16rpx;
}

.template-card-stats {
  display: flex;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #E5E7EB;
}

.stat-item:last-child {
  border-right: none;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #6B7280;
}

/* 进度条 */
.template-card-progress {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.progress-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-label {
  font-size: 24rpx;
  color: #6B7280;
}

.progress-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.progress-bar {
  height: 16rpx;
  background: #E5E7EB;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

/* 分数分布图 */
.score-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 280rpx;
  padding: 24rpx 0;
}

.chart-bar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  height: 100%;
  justify-content: flex-end;
}

.chart-bar-bg {
  width: 40rpx;
  height: 200rpx;
  background: #F3F4F6;
  border-radius: 8rpx 8rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.chart-bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 4rpx;
  transition: height 0.6s ease;
}

.chart-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #1F2937;
  margin-top: 12rpx;
}

.chart-label {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 题目诊断 */
.subtitle {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  display: block;
  margin-bottom: 20rpx;
}

.question-diagnosis {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.diagnosis-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.diagnosis-rank {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  padding-top: 4rpx;
}

.rank-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.diagnosis-content {
  flex: 1;
  min-width: 0;
}

.diagnosis-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #1F2937;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.diagnosis-meta {
  margin-bottom: 12rpx;
}

.diagnosis-template {
  font-size: 22rpx;
  color: #9CA3AF;
}

.diagnosis-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.correct-rate-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.correct-rate-label {
  font-size: 20rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.correct-rate-bar {
  flex: 1;
  height: 12rpx;
  background: #E5E7EB;
  border-radius: 999rpx;
  overflow: hidden;
}

.correct-rate-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.correct-rate-value {
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.time-spent {
  font-size: 22rpx;
  color: #6B7280;
  flex-shrink: 0;
}

/* 底部说明 */
.footer-note {
  text-align: center;
  padding: 32rpx 0;
  font-size: 22rpx;
  color: #9CA3AF;
  line-height: 1.8;
}