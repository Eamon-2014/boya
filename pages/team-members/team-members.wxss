.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 0 32rpx;
  padding-top: 24rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card-wrap {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stat-card-wrap.active .stat-val { color: #10B981; }
.stat-card-wrap.leave .stat-val { color: #F59E0B; }
.stat-card-wrap.inactive .stat-val { color: #9CA3AF; }

.stat-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.2;
}

.stat-lbl {
  display: block;
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.filter-bar {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-box {
  display: flex;
  align-items: center;
  background: #F3F4F6;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  background: transparent;
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.filter-tab {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6B7280;
  background: #F3F4F6;
  transition: all 0.2s;
}

.filter-tab.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member-initial {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.member-role {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.member-contact {
  font-size: 24rpx;
  color: #6B7280;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-stats-row {
  display: flex;
  gap: 20rpx;
}

.member-stat {
  font-size: 22rpx;
  color: #6B7280;
}

.member-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), #4F46E5);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx var(--color-primary-bg);
  z-index: 100;
}

.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.modal-card {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 32rpx;
}

.modal-body {
  padding: 32rpx;
}

.modal-desc {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
}

.role-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.role-chip {
  padding: 16rpx 28rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #374151;
}
