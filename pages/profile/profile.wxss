/* pages/profile/profile.wxss */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 0 32rpx;
  padding-top: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 头部 */
.profile-header {
  background: var(--color-primary-gradient);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin: 0 -32rpx 32rpx;
  margin-top: -24rpx;
  color: #FFFFFF;
}

.profile-header-inner {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 32rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 6rpx;
}

.profile-role {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 16rpx;
}

.profile-stats {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.profile-stat-item {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.profile-setting {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 账号信息卡片 */
.account-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 32rpx;
}

.account-card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.account-card-icon {
  font-size: 32rpx;
}

.account-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F9FAFB;
}

.account-row:last-child {
  border-bottom: none;
}

.account-label {
  font-size: 26rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.account-value {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.account-pwd-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pwd-toggle {
  padding: 4rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.85;
}

.pwd-toggle:active .eye-icon {
  opacity: 1;
}

/* 业务概览 */
.overview-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 32rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 32rpx 24rpx;
}

.overview-item {
  display: flex;
  align-items: center;
}

.overview-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.overview-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
  line-height: 1.2;
}

.overview-label {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}

.section-header-custom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
}

.section-bar {
  width: 6rpx;
  height: 28rpx;
  background: var(--color-primary-gradient);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.section-action {
  font-size: 24rpx;
  color: var(--color-primary);
}

/* AI教师卡片 */
.teacher-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
}

.teacher-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.teacher-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.teacher-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: rgba(139, 92, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.teacher-info {
  flex: 1;
  min-width: 0;
}

.teacher-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.teacher-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.teacher-desc {
  font-size: 22rpx;
  color: #9CA3AF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.lang-tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.teacher-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.spec-tag {
  padding: 4rpx 12rpx;
  background: rgba(139, 92, 246, 0.1);
  color: #8B5CF6;
  font-size: 22rpx;
  border-radius: 4rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.teacher-progress {
  margin-top: 24rpx;
}

.progress-bar {
  height: 8rpx;
  background: #F3F4F6;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: #8B5CF6;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

.progress-action {
  font-size: 22rpx;
  color: #8B5CF6;
}

.teacher-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

.stat-cell {
  text-align: center;
}

.stat-cell-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.2;
}

.stat-cell-label {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 通用标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  line-height: 1.2;
  white-space: nowrap;
  flex-shrink: 0;
}

.tag-rounded {
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 菜单 */
.menu-group {
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.menu-item {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #F3F4F6;
}

.menu-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 28rpx;
  color: #1F2937;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-subtitle {
  font-size: 22rpx;
  color: #9CA3AF;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.menu-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #EF4444;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 8rpx;
}

.menu-arrow {
  color: #9CA3AF;
  font-size: 34rpx;
}

/* AI教师训练中心 */
.training-center {
  background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(79, 70, 229, 0.2);
}

.training-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.training-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.training-icon {
  font-size: 36rpx;
}

.training-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.training-action {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.training-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}

.training-stat-item {
  flex: 1;
  text-align: center;
}

.training-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.training-stat-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.training-stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

.training-progress-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.training-item {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.training-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.training-item-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.training-item-pct {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.training-item-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  overflow: hidden;
}

.training-item-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.5s ease;
}

.training-empty {
  text-align: center;
  padding: 16rpx;
}

.training-empty-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
