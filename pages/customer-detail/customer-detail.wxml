<!--pages/customer-detail/customer-detail.wxml-->
<view class="page" wx:if="{{customer}}">
  <!-- 头部卡片 -->
  <view class="header-card">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="avatar" style="background: {{avatarColor}}">
        <text class="avatar-text">{{initial}}</text>
      </view>
      <view class="info-main">
        <view class="name-row">
          <text class="name">{{customer.name}}</text>
          <view class="status-tag" style="background: {{statusBg}}; color: {{statusColor}}">{{statusLabel}}</view>
        </view>
        <view class="sub-info">
          <text class="lang-badge" style="background: {{languageColor}}20; color: {{languageColor}}">{{languageLabel}}</text>
          <text class="child-info">孩子：{{customer.childName}} · {{customer.childAge}}岁 · {{customer.childGrade}}</text>
        </view>
        <view class="phone-row">
          <text class="phone">{{maskedPhone}}</text>
          <view class="phone-actions">
            <view class="action-icon" bindtap="onCopyPhone">📋</view>
            <view class="action-icon" bindtap="onCallPhone">📞</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      bindtap="switchTab" data-tab="{{item.key}}">
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <block wx:if="{{activeTab === 'info'}}">
    <view class="card">
      <view class="card-title">基础档案</view>
      <view class="info-row">
        <text class="info-key">客户来源</text>
        <text class="info-value">{{customer.source || '未记录'}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">目标考试</text>
        <text class="info-value">{{customer.targetExam || '未设置'}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">跟进次数</text>
        <text class="info-value">{{customer.followCount || 0}} 次</text>
      </view>
      <view class="info-row">
        <text class="info-key">最近跟进</text>
        <text class="info-value">{{customer.lastFollowAt ? '已跟进' : '待跟进'}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">创建时间</text>
        <text class="info-value">{{customer.createdAtText || '—'}}</text>
      </view>
      <view wx:if="{{customer.remark}}" class="info-remark">
        <text class="info-key">备注</text>
        <text class="remark-text">{{customer.remark}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">标签</view>
      <view class="tag-list" wx:if="{{customer.tags.length > 0}}">
        <view wx:for="{{customer.tags}}" wx:key="*this" class="tag-item">{{item}}</view>
      </view>
      <view wx:else class="empty-tags">暂无标签</view>
    </view>

    <view class="action-grid">
      <view class="grid-item" bindtap="onCallPhone">
        <view class="grid-icon phone-icon">📞</view>
        <text class="grid-label">拨打电话</text>
      </view>
      <view class="grid-item" bindtap="onAssignSurvey">
        <view class="grid-icon survey-icon">📝</view>
        <text class="grid-label">推送问卷</text>
      </view>
      <view class="grid-item" bindtap="onShowAddFollow">
        <view class="grid-icon follow-icon">➕</view>
        <text class="grid-label">添加跟进</text>
      </view>
      <view class="grid-item" bindtap="onChangeStatus">
        <view class="grid-icon status-icon">🔄</view>
        <text class="grid-label">转换状态</text>
      </view>
    </view>
  </block>

  <!-- 跟进记录 -->
  <block wx:if="{{activeTab === 'follow'}}">
    <view class="follow-header">
      <text class="follow-count">共 {{followRecords.length}} 条记录</text>
      <view class="follow-add-btn" bindtap="onShowAddFollow">+ 新增</view>
    </view>

    <view class="timeline">
      <view wx:for="{{followRecords}}" wx:key="id" class="timeline-item">
        <view class="timeline-dot {{item.isLatest ? 'latest' : ''}}"></view>
        <view class="timeline-content">
          <view class="timeline-header">
            <text class="timeline-icon">{{item.icon}}</text>
            <text class="timeline-type">{{item.typeLabel}}</text>
            <text class="timeline-time">{{item.timeText}}</text>
            <view class="timeline-delete" catchtap="onDeleteFollowRecord" data-id="{{item.id}}">🗑</view>
          </view>
          <text class="timeline-text">{{item.content}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 历史记录 -->
  <block wx:if="{{activeTab === 'history'}}">
    <view class="card">
      <view class="card-title">问卷记录 ({{relatedAssignments.length}})</view>
      <view wx:if="{{relatedAssignments.length > 0}}" class="history-list">
        <view wx:for="{{relatedAssignments}}" wx:key="id" class="history-item">
          <view class="history-icon">📋</view>
          <view class="history-info">
            <text class="history-title">{{item.templateName}}</text>
            <text class="history-meta">发放于 {{item.assignedAtText}} · {{item.statusLabel}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-state">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无问卷记录</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">评估报告 ({{relatedReports.length}})</view>
      <view wx:if="{{relatedReports.length > 0}}" class="history-list">
        <view wx:for="{{relatedReports}}" wx:key="id" class="history-item" bindtap="onViewReport" data-id="{{item.id}}">
          <view class="history-icon">📊</view>
          <view class="history-info">
            <view class="history-title-row">
              <text class="history-title">{{item.templateName}}</text>
              <view class="score-badge" style="background: {{item.scoreLevel.color}}20; color: {{item.scoreLevel.color}}">{{item.overallScore}}分</view>
            </view>
            <text class="history-meta">{{item.createdAtText}} · {{item.statusLabel}}</text>
          </view>
          <text class="history-arrow">›</text>
        </view>
      </view>
      <view wx:else class="empty-state">
        <text class="empty-icon">📊</text>
        <text class="empty-text">暂无评估报告</text>
      </view>
    </view>
  </block>

  <!-- 删除客户按钮 -->
  <view class="delete-customer-btn" bindtap="onDeleteCustomer">
    <text>🗑 {{texts.deleteCustomer}}</text>
  </view>

  <!-- 添加跟进弹窗 -->
  <view class="modal-overlay" wx:if="{{showAddFollow}}">
    <view class="modal-container">
      <view class="modal-header">
        <text class="modal-title">添加跟进记录</text>
        <view class="modal-close" bindtap="onHideAddFollow">✕</view>
      </view>
      <view class="modal-body">
        <view class="form-label">跟进方式</view>
        <view class="follow-type-list">
          <view wx:for="{{followTypes}}" wx:key="key"
            class="follow-type-item {{newFollowType === item.key ? 'active' : ''}}"
            bindtap="onFollowTypeChange" data-type="{{item.key}}">
            <text class="follow-type-icon">{{item.icon}}</text>
            <text class="follow-type-label">{{item.label}}</text>
          </view>
        </view>
        <view class="form-label">跟进内容</view>
        <textarea class="follow-textarea" placeholder="请描述本次沟通的详细内容..." value="{{newFollowContent}}" bindinput="onFollowContentInput" auto-height maxlength="300" />
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="onHideAddFollow">取消</view>
        <view class="modal-btn confirm" bindtap="onSubmitFollow">保存</view>
      </view>
    </view>
  </view>
</view>
