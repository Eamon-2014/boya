/* pages/user-management/user-management.wxss */
.page-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-header {
  padding: 40rpx 32rpx 60rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.user-list {
  padding: 0 24rpx;
  margin-top: -32rpx;
}

.user-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.user-info {
  display: flex;
  align-items: flex-start;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.user-detail {
  flex: 1;
  overflow: hidden;
}

.user-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.user-role-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.builtin-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #F3F4F6;
  color: #6B7280;
}

.self-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #DBEAFE;
  color: #2563EB;
}

.user-meta {
  margin-top: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #6B7280;
}

.user-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
}

.impersonate-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  border: none;
  padding: 0;
}

.impersonate-btn::after {
  border: none;
}

.current-mark {
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 0;
}

.loading-tip,
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #9CA3AF;
}
