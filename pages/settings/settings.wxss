.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

.group-header {
  padding: 32rpx 32rpx 16rpx;
}

.group-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  letter-spacing: 2rpx;
}

.settings-card {
  background: #FFFFFF;
  margin: 0 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.setting-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  width: 64rpx;
  height: 64rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.setting-info {
  flex: 1;
  min-width: 0;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}

.setting-desc {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.setting-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.control-switch {
  width: 88rpx;
  height: 52rpx;
  background: #D1D5DB;
  border-radius: 999rpx;
  padding: 4rpx;
  transition: background 0.2s;
}

.control-switch.on {
  background: #10B981;
}

.control-switch.on .switch-dot {
  transform: translateX(36rpx);
}

.switch-dot {
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
  border-radius: 50%;
  transition: transform 0.2s;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.control-value {
  font-size: 26rpx;
  color: #374151;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.control-value.muted {
  color: #9CA3AF;
  font-size: 24rpx;
}

.control-arrow {
  font-size: 36rpx;
  color: #D1D5DB;
  font-weight: 300;
}

.logout-btn {
  margin: 64rpx 32rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #EF4444;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.picker-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.picker-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 32rpx;
}

.picker-body {
  padding: 16rpx 0;
  max-height: 600rpx;
  overflow-y: auto;
}

.picker-option {
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: #1F2937;
  border-bottom: 1rpx solid #F9FAFB;
}

.picker-option:last-child {
  border-bottom: none;
}

/* ============ 更改身份弹窗 ============ */
.role-current {
  font-size: 28rpx;
  color: #6B7280;
  padding: 16rpx 0 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
  margin-bottom: 24rpx;
}

.role-current-value {
  color: var(--color-primary, #2563EB);
  font-weight: 600;
  margin-left: 8rpx;
}

.role-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.role-option {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.role-option.active {
  background: var(--color-primary-bg, rgba(37, 99, 235, 0.08));
  border-color: var(--color-primary, #2563EB);
}

.role-option-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.role-option-label {
  flex: 1;
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 500;
}

.role-option-check {
  color: var(--color-primary, #2563EB);
  font-size: 36rpx;
  font-weight: 700;
}

.role-code-field {
  margin-top: 28rpx;
  padding: 24rpx;
  background: #FFFBEB;
  border-radius: 12rpx;
  border: 1rpx solid #FDE68A;
}

.role-code-label {
  font-size: 26rpx;
  color: #92400E;
  font-weight: 500;
  display: block;
  margin-bottom: 16rpx;
}

.role-code-required {
  color: #EF4444;
}

.role-code-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.role-code-input {
  flex: 1;
  background: #FFFFFF !important;
  border: 1rpx solid #FDE68A;
  letter-spacing: 8rpx;
  padding-right: 80rpx;
}

.pwd-toggle {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.85;
}

.pwd-toggle:active .eye-icon {
  opacity: 1;
}

.role-code-tip {
  font-size: 22rpx;
  color: #92400E;
  margin-top: 12rpx;
  display: block;
}

.modal-btn.disabled {
  opacity: 0.6;
}

/* 接口配置表单 */
.form-field {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}
