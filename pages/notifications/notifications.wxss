.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.unread-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.unread-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #EF4444;
}

.unread-label {
  font-size: 26rpx;
  color: #6B7280;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  background: #EFF6FF;
  color: var(--color-primary);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.danger {
  background: #FEF2F2;
  color: #EF4444;
}

.filter-scroll {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 16rpx 32rpx;
  border-top: 1rpx solid #F3F4F6;
  border-bottom: 1rpx solid #F3F4F6;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.filter-chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6B7280;
  background: #F3F4F6;
}

.filter-chip.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.notif-list {
  padding: 20rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.notif-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.notif-hover {
  transform: scale(0.98);
  opacity: 0.85;
}

.notif-card.read {
  opacity: 0.7;
}

.notif-card.unread {
  background: linear-gradient(135deg, #FFFFFF 0%, #F8FAFF 100%);
  box-shadow: 0 2rpx 12rpx var(--color-primary-bg);
}

.notif-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.notif-body {
  flex: 1;
  min-width: 0;
}

.notif-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.notif-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.notif-dot {
  width: 16rpx;
  height: 16rpx;
  background: #EF4444;
  border-radius: 50%;
  flex-shrink: 0;
}

.notif-content {
  display: block;
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.notif-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.notif-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.notif-link {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.empty-state {
  text-align: center;
  padding: 120rpx 64rpx;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 8rpx;
}

.empty-sub {
  display: block;
  font-size: 26rpx;
  color: #9CA3AF;
}

/* ===== 注册申请审批按钮 ===== */
.approval-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.approval-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.approval-btn.approve {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

/* ============ 通知详情弹窗 ============ */
.detail-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.detail-card {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  animation: detailPop 0.2s ease;
}

@keyframes detailPop {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.detail-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F1F3;
  gap: 20rpx;
}

.detail-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.detail-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #9CA3AF;
  border-radius: 50%;
  background: #F3F4F6;
  flex-shrink: 0;
}

.detail-body {
  padding: 32rpx;
}

.detail-content {
  font-size: 30rpx;
  color: #374151;
  line-height: 1.7;
  display: block;
  margin-bottom: 24rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-time {
  font-size: 24rpx;
  color: #9CA3AF;
}

.detail-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.detail-status.unread {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
}

.detail-status.read {
  background: #F3F4F6;
  color: #9CA3AF;
}

.detail-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F0F1F3;
}

.detail-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.detail-btn-cancel {
  background: #F3F4F6;
  color: #6B7280;
}

.detail-btn-delete {
  background: rgba(239, 68, 68, 0.1);
  color: #EF4444;
  flex: 0 0 auto;
  padding: 0 32rpx;
}

.detail-btn-primary {
  background: var(--color-primary-gradient, linear-gradient(135deg, #2563EB, #4F46E5));
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.3);
}

.approval-btn.approve:active {
  background: #10B981;
  color: #FFFFFF;
}

.approval-btn.reject {
  background: rgba(239, 68, 68, 0.08);
  color: #EF4444;
  border: 1rpx solid rgba(239, 68, 68, 0.25);
}

.approval-btn.reject:active {
  background: #EF4444;
  color: #FFFFFF;
}

/* 已审批状态标签 */
.approval-status {
  margin-top: 16rpx;
}

.status-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-tag.approved {
  background: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

.status-tag.rejected {
  background: rgba(239, 68, 68, 0.08);
  color: #EF4444;
}
