/* pages/questionnaire-fill/questionnaire-fill.wxss */
.page {
  padding: 24rpx;
  padding-bottom: 180rpx;
  background-color: var(--color-bg-page);
  min-height: 100vh;
}

/* 进度栏 */
.progress-bar {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-text {
  font-size: 24rpx;
  color: #6B7280;
}

.progress-track {
  height: 12rpx;
  background: #E5E7EB;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: var(--color-primary-gradient);
  border-radius: 6rpx;
  transition: width 0.3s ease-out;
}

.progress-steps {
  display: flex;
  gap: 12rpx;
  padding: 0 4rpx;
}

.step-dot {
  flex: 1;
  height: 12rpx;
  background: #E5E7EB;
  border-radius: 6rpx;
  transition: all 0.2s;
}

.step-dot.answered {
  background: #10B981;
}

.step-dot.current {
  background: var(--color-primary);
  height: 16rpx;
  transform: scaleY(1.3);
}

/* 题目卡片 */
.question-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.question-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.question-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.question-num {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.question-type-tag {
  padding: 6rpx 16rpx;
  background: #EFF6FF;
  color: var(--color-primary);
  border-radius: 8rpx;
  font-size: 22rpx;
}

.required-mark {
  font-size: 24rpx;
  color: #EF4444;
  font-weight: 500;
}

.question-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

/* 选项列表 */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.option-item.selected {
  background: #EFF6FF;
  border-color: var(--color-primary);
}

.option-radio {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #D1D5DB;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
  transition: all 0.2s;
}

.option-radio.checked {
  border-color: var(--color-primary);
}

.option-radio.checked::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  background: var(--color-primary);
  border-radius: 50%;
}

.option-checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid #D1D5DB;
  border-radius: 8rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.option-checkbox.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.option-checkbox.checked::after {
  content: '✓';
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.option-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.option-label {
  font-size: 30rpx;
  color: #374151;
}

.option-score {
  font-size: 24rpx;
  color: #9CA3AF;
}

.multi-hint {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 20rpx;
  padding-left: 8rpx;
}

/* 填空题 */
.text-input {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1F2937;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 评分题 */
.rating-display {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.rating-value {
  font-size: 80rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.rating-max {
  font-size: 32rpx;
  color: #9CA3AF;
}

.rating-slider {
  width: 100%;
  margin: 0;
}

.rating-range {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 0 20rpx;
  margin-top: 16rpx;
}

/* 量表题 */
.scale-options {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.scale-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  background: #F9FAFB;
  border: 3rpx solid #E5E7EB;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.scale-item.selected {
  background: #EFF6FF;
  border-color: var(--color-primary);
  transform: scale(1.05);
}

.scale-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.scale-item.selected .scale-value {
  color: var(--color-primary);
}

.scale-label {
  font-size: 24rpx;
  color: #6B7280;
  text-align: center;
}

.scale-item.selected .scale-label {
  color: var(--color-primary);
  font-weight: 500;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bar-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.bar-btn.prev {
  background: #F3F4F6;
  color: #6B7280;
  flex: 0.8;
}

.bar-btn.prev.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.bar-btn.next {
  background: var(--color-primary-gradient);
  color: #fff;
  box-shadow: 0 8rpx 20rpx var(--color-primary-bg);
}

.bar-btn.submit {
  background: #10B981;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-container {
  width: 85%;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
}

.modal-header {
  padding: 40rpx 32rpx 20rpx;
  text-align: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2937;
}

.modal-body {
  padding: 20rpx 32rpx 32rpx;
}

.confirm-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 28rpx;
}

.confirm-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.confirm-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.confirm-label {
  font-size: 24rpx;
  color: #6B7280;
}

.confirm-divider {
  width: 2rpx;
  height: 60rpx;
  background: #E5E7EB;
}

.confirm-tip {
  display: block;
  font-size: 26rpx;
  color: #9CA3AF;
  text-align: center;
  line-height: 1.6;
}

/* AI 评估选择器 */
.ai-select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.ai-select-label {
  font-size: 28rpx;
  color: #374151;
  white-space: nowrap;
}

.ai-select-picker {
  flex: 1;
  margin-left: 24rpx;
}

.ai-select-value {
  font-size: 28rpx;
  color: #9CA3AF;
  text-align: right;
  padding: 8rpx 0;
}

.ai-select-value.selected {
  color: #2563EB;
  font-weight: 500;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 0 32rpx 32rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background: #F3F4F6;
  color: #6B7280;
  flex: 0.8;
}

.modal-btn.confirm {
  background: var(--color-primary-gradient);
  color: #fff;
}

.submitting-mask {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(255, 255, 255, 0.95);
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E5E7EB;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.submitting-text {
  font-size: 28rpx;
  color: #374151;
}
