/* pages/report-detail/report-detail.wxss */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 0 32rpx;
  padding-top: 24rpx;
  padding-bottom: 64rpx;
  box-sizing: border-box;
}

/* Hero 卡片 */
.hero-card {
  position: relative;
  background: linear-gradient(135deg, var(--color-primary) 0%, #4F46E5 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.hero-bg-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-bg-circle.c1 {
  width: 240rpx;
  height: 240rpx;
  top: -80rpx;
  right: -40rpx;
}

.hero-bg-circle.c2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -40rpx;
  left: -30rpx;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-lang-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.hero-template {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  margin-bottom: 6rpx;
}

.hero-ai {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  display: block;
}

.hero-score-box {
  text-align: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  min-width: 140rpx;
  margin-left: 24rpx;
}

.hero-score-num {
  display: block;
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #FFFFFF;
}

.hero-score-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 4rpx;
}

.hero-score-level {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.hero-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.status-chip {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.hero-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 操作栏 */
.action-bar {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 4rpx;
  transition: transform 0.15s;
}

/* 分享按钮重置（button 元素复用 action-item 样式） */
.share-action {
  margin: 0;
  background: transparent;
  line-height: normal;
}

.share-action::after {
  border: none;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.action-icon.approve {
  background: rgba(16, 185, 129, 0.12);
  color: #10B981;
}

.action-icon.reject {
  background: rgba(239, 68, 68, 0.12);
  color: #EF4444;
}

.action-icon.push {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.action-icon.share {
  background: rgba(16, 185, 129, 0.12);
  color: #10B981;
}

.action-icon.delete {
  background: rgba(239, 68, 68, 0.12);
  color: #EF4444;
}

.delete-action:active {
  opacity: 0.7;
}

.action-icon.export {
  background: rgba(139, 92, 246, 0.12);
  color: #8B5CF6;
}

.action-label {
  font-size: 22rpx;
  color: #374151;
  font-weight: 500;
}

.action-item.disabled {
  opacity: 0.5;
}

.action-icon.approved {
  background: rgba(16, 185, 129, 0.12);
  color: #10B981;
}

.action-icon.rejected {
  background: rgba(239, 68, 68, 0.12);
  color: #EF4444;
}

.action-icon.sent {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

/* 状态提示 */
.reject-hint {
  background: #FEF2F2;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #EF4444;
}

.reject-hint-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #EF4444;
  margin-right: 8rpx;
}

.reject-hint-text {
  font-size: 26rpx;
  color: #374151;
}

.push-hint {
  background: #F0FDF4;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #10B981;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.push-hint-icon {
  width: 40rpx;
  height: 40rpx;
  background: #10B981;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.push-hint-text {
  font-size: 26rpx;
  color: #065F46;
  flex: 1;
}

/* ===== 弹窗通用 ===== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.modal-card {
  width: 640rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 32rpx;
}

.modal-body {
  padding: 32rpx;
  flex: 1;
  overflow-y: auto;
}

.modal-desc {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.modal-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 16rpx;
  margin-top: 16rpx;
}

.modal-label:first-of-type {
  margin-top: 0;
}

.modal-textarea {
  width: 100%;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  min-height: 160rpx;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #F3F4F6;
  flex-shrink: 0;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 500;
}

.modal-btn.cancel {
  background: #F3F4F6;
  color: #6B7280;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, var(--color-primary), #4F46E5);
  color: #FFFFFF;
}

.modal-btn.reject-btn {
  background: #EF4444;
}

.modal-btn.push-btn {
  background: linear-gradient(135deg, var(--color-primary), #4F46E5);
}

.modal-btn.push-btn.disabled {
  opacity: 0.6;
}

/* ===== 推送弹窗 ===== */
.push-parent-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.push-parent-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.push-parent-detail {
  flex: 1;
  min-width: 0;
}

.push-parent-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.push-parent-sub {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.channel-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.channel-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.channel-item.active {
  background: #EFF6FF;
  border-color: var(--color-primary);
}

.channel-icon {
  width: 64rpx;
  height: 64rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.channel-info {
  flex: 1;
  min-width: 0;
}

.channel-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}

.channel-desc {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 2rpx;
}

.channel-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  flex-shrink: 0;
  transition: all 0.2s;
}

.channel-radio.checked {
  border-color: var(--color-primary);
  background: var(--color-primary);
  box-shadow: inset 0 0 0 8rpx #FFFFFF;
}

/* Tab 导航 */
.tab-nav {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab-nav-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
  transition: all 0.2s;
}

.tab-nav-item.active {
  background: linear-gradient(135deg, var(--color-primary), #4F46E5);
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx var(--color-primary-bg);
}

/* 卡片通用 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 24rpx;
}

.card-title-wrap {
  margin-bottom: 24rpx;
}

/* 雷达图 */
.radar-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.radar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F9FAFB;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-label {
  color: #374151;
}

.legend-score {
  font-weight: 600;
}

.radar-visual {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.radar-bar-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.radar-bar-label {
  width: 120rpx;
  font-size: 24rpx;
  color: #374151;
  flex-shrink: 0;
}

.radar-bar {
  flex: 1;
  height: 16rpx;
  background: #F3F4F6;
  border-radius: 999rpx;
  overflow: hidden;
}

.radar-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.5s ease;
}

.radar-bar-pct {
  width: 80rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
  flex-shrink: 0;
}

/* 双列卡片 */
.dual-card {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.dual-col {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.dual-col.strengths {
  border-top: 4rpx solid #10B981;
}

.dual-col.weaknesses {
  border-top: 4rpx solid #F59E0B;
}

.dual-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 20rpx;
}

.dual-icon {
  font-size: 28rpx;
}

.dual-point {
  padding: 8rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.dual-point:last-child {
  border-bottom: none;
}

.dual-point-text {
  font-size: 24rpx;
  color: #374151;
  line-height: 1.5;
}

/* 维度卡片 */
.dim-card {
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.dim-card:last-child {
  margin-bottom: 0;
}

.dim-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.dim-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.dim-score-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.dim-progress {
  height: 12rpx;
  background: #E5E7EB;
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.dim-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 0.5s ease;
}

.dim-desc {
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

/* 建议列表 */
.suggestion-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), #4F46E5);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.suggestion-text {
  flex: 1;
  font-size: 26rpx;
  color: #1F2937;
  line-height: 1.6;
}

/* 学习计划时间线 */
.plan-block {
  display: flex;
  gap: 20rpx;
  padding-bottom: 16rpx;
  position: relative;
}

.plan-timeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 32rpx;
  flex-shrink: 0;
}

.plan-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), #4F46E5);
  box-shadow: 0 0 0 6rpx var(--color-primary-bg);
  flex-shrink: 0;
}

.plan-line {
  width: 4rpx;
  flex: 1;
  background: linear-gradient(to bottom, var(--color-primary), #E5E7EB);
  margin: 8rpx 0;
  min-height: 40rpx;
}

.plan-body {
  flex: 1;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 20rpx;
}

.plan-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.plan-phase {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.plan-duration {
  font-size: 22rpx;
  color: #6B7280;
  background: var(--color-primary-bg);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.plan-focus {
  font-size: 24rpx;
  color: #374151;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.plan-focus-label {
  color: var(--color-primary);
  font-weight: 600;
}

.plan-task {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  padding: 6rpx 0;
  font-size: 24rpx;
  color: #4B5563;
  line-height: 1.5;
}

.plan-task-bullet {
  color: var(--color-primary);
  flex-shrink: 0;
}

/* 占位 */
.placeholder {
  padding: 160rpx 48rpx;
  text-align: center;
}

.placeholder-icon {
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 48rpx;
  background: #F3F4F6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
}

.placeholder-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.placeholder-desc {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
  margin-bottom: 64rpx;
}

.page-bottom-space {
  height: 64rpx;
}

/* 分享面板 */
.share-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.share-panel {
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.share-panel-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.share-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.share-panel-body {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.share-btn-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx 16rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  border: none;
  line-height: normal;
}

.share-btn-item::after {
  display: none;
}

.share-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.share-icon-friend {
  background: linear-gradient(135deg, #07C160 0%, #10B981 100%);
}

.share-icon-timeline {
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
}

.share-icon-image {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
}

.share-text {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
}

.share-panel-footer {
  padding-top: 24rpx;
  border-top: 1rpx solid #E5E7EB;
}

.share-cancel-btn {
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
}

/* 分享卡片预览 */
.share-preview {
  margin-top: 32rpx;
}

.share-preview-card {
  background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  color: #FFFFFF;
}

.share-preview-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.share-preview-title {
  font-size: 28rpx;
  font-weight: 600;
}

.share-preview-level {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.share-preview-stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

