/* pages/workflow-tracking/workflow-tracking.wxss */

.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 0 32rpx;
  padding-top: 24rpx;
  padding-bottom: 64rpx;
  box-sizing: border-box;
}

/* 概览卡片 */
.overview-card {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.2);
}

.overview-header {
  margin-bottom: 28rpx;
}

.overview-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 24rpx;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.overview-unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 4rpx;
}

.overview-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.bottleneck-item {
  background: rgba(239, 68, 68, 0.3);
}

/* 流程管道卡片 */
.pipeline-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 24rpx;
}

.pipeline-header {
  margin-bottom: 32rpx;
}

.pipeline-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.pipeline-flow {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 阶段节点 */
.stage-node {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--stage-bg);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  position: relative;
}

.stage-node:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.stage-node.bottleneck {
  background: rgba(239, 68, 68, 0.08);
  border-color: rgba(239, 68, 68, 0.3);
}

.stage-icon-wrap {
  position: relative;
  flex-shrink: 0;
}

.stage-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.bottleneck-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: #EF4444;
  border-radius: 16rpx;
  padding: 4rpx 12rpx;
}

.bottleneck-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.stage-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stage-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.stage-node.bottleneck .stage-title {
  color: #EF4444;
}

.stage-count {
  font-size: 24rpx;
  color: var(--stage-color);
  font-weight: 500;
}

.stage-time {
  font-size: 22rpx;
  color: #6B7280;
}

.stage-arrow {
  flex-shrink: 0;
  padding: 0 8rpx;
}

.arrow-icon {
  font-size: 32rpx;
  color: #D1D5DB;
}

/* 阶段详情面板 */
.stage-detail-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.stage-detail-panel.show {
  opacity: 1;
  visibility: visible;
}

.stage-detail-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.stage-detail-content {
  position: relative;
  margin-top: auto;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.stage-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.stage-detail-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stage-detail-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.bottleneck-badge-sm {
  background: rgba(239, 68, 68, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.bottleneck-badge-sm .bottleneck-text {
  color: #EF4444;
  font-size: 20rpx;
}

.stage-detail-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  border-radius: 50%;
}

.close-icon {
  font-size: 28rpx;
  color: #6B7280;
}

.stage-detail-list {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 32rpx;
}

/* 客户项 */
.customer-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s ease;
}

.customer-item:active {
  background: #F3F4F6;
  transform: scale(0.98);
}

.customer-info {
  flex: 1;
  min-width: 0;
}

.customer-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.customer-child {
  font-size: 22rpx;
  color: #6B7280;
}

.customer-status-wrap {
  flex-shrink: 0;
}

.customer-status-tag {
  background: var(--color-primary-bg);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.customer-status {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.customer-stay {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.stay-label {
  font-size: 20rpx;
  color: #9CA3AF;
}

.stay-value {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
}

.customer-score {
  flex-shrink: 0;
  background: rgba(245, 158, 11, 0.1);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.score-value {
  font-size: 24rpx;
  color: #F59E0B;
  font-weight: 600;
}

.customer-arrow {
  flex-shrink: 0;
}

.arrow-right {
  font-size: 32rpx;
  color: #D1D5DB;
}

/* 空状态 */
.stage-detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 底部说明 */
.footer-note {
  text-align: center;
  padding: 32rpx 0;
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 响应式 */
@media (max-width: 360px) {
  .overview-grid {
    gap: 16rpx;
  }

  .overview-item {
    padding: 20rpx;
  }

  .overview-value {
    font-size: 36rpx;
  }
}
