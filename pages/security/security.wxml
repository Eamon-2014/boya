<view class="page">
  <!-- Tab 导航 -->
  <view class="tab-bar">
    <view wx:for="{{tabs}}" wx:key="index"
      class="tab-item {{tabIndex === index ? 'active' : ''}}"
      data-idx="{{index}}" bindtap="onTabChange">
      {{item}}
    </view>
  </view>

  <!-- 权限管理 Tab -->
  <block wx:if="{{tabIndex === 0}}">
    <view class="section-card">
      <view class="section-header">
        <text class="section-title">角色权限配置</text>
        <text class="section-desc">选择角色后勾选功能模块权限</text>
      </view>
      <view class="role-tabs">
        <view wx:for="{{roles}}" wx:key="key"
          class="role-tab {{selectedRoleIdx === index ? 'active' : ''}}"
          data-idx="{{index}}" bindtap="onSelectRole"
          style="{{selectedRoleIdx === index ? 'background:' + item.color : ''}}">
          {{item.label}}
        </view>
      </view>
      <view class="module-list">
        <view wx:for="{{modules}}" wx:key="key" class="module-item">
          <view class="module-icon">{{item.icon}}</view>
          <view class="module-info">
            <text class="module-label">{{item.label}}</text>
            <text class="module-desc">{{item.desc}}</text>
          </view>
          <view class="module-switch {{roles[selectedRoleIdx].perms.indexOf(item.key) >= 0 ? 'on' : ''}}"
            data-mod="{{item.key}}" catchtap="onTogglePerm">
            <view class="switch-dot"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-header">
        <text class="section-title">权限说明</text>
      </view>
      <view class="perm-hint">
        <text class="hint-text">· 权限变更将实时同步到该角色下的所有成员</text>
        <text class="hint-text">· 高敏感操作需二次验证身份</text>
        <text class="hint-text">· 所有权限变更将记录到审计日志</text>
      </view>
    </view>
  </block>

  <!-- 访问日志 Tab -->
  <block wx:if="{{tabIndex === 1}}">
    <view class="log-summary">
      <view class="summary-item">
        <text class="summary-val">{{logs.length}}</text>
        <text class="summary-lbl">今日操作</text>
      </view>
      <view class="summary-item warn">
        <text class="summary-val">2</text>
        <text class="summary-lbl">关注级别</text>
      </view>
      <view class="summary-btn" bindtap="onExportLog">导出日志</view>
    </view>

    <view class="log-list">
      <view wx:for="{{logs}}" wx:key="id" class="log-item">
        <view class="log-time">{{item.time}}</view>
        <view class="log-content">
          <view class="log-action-row">
            <text class="log-user">{{item.user}}</text>
            <text class="log-action">{{item.action}}</text>
          </view>
          <text class="log-target">目标：{{item.target}}</text>
          <text class="log-ip">IP：{{item.ip}}</text>
        </view>
        <view class="log-risk" style="background: {{item.bg}}; color: {{item.color}}">
          {{item.label}}
        </view>
      </view>
      <view class="log-empty" wx:if="{{logs.length === 0}}">
        <text class="log-empty-text">暂无日志记录</text>
      </view>
    </view>
  </block>

  <!-- 安全设置 Tab -->
  <block wx:if="{{tabIndex === 2}}">
    <view class="security-list">
      <view wx:for="{{securitySettings}}" wx:key="key" class="security-item">
        <view class="security-info">
          <text class="security-label">{{item.label}}</text>
          <text class="security-desc">{{item.desc}}</text>
        </view>
        <view class="security-switch {{item.enabled ? 'on' : ''}}"
          data-key="{{item.key}}" catchtap="onToggleSetting">
          <view class="switch-dot"></view>
        </view>
      </view>
    </view>
  </block>
</view>
