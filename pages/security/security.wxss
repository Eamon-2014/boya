.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 60rpx;
}

.tab-bar {
  display: flex;
  background: #FFFFFF;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #E5E7EB;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  position: relative;
  transition: color 0.2s;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

.section-card {
  background: #FFFFFF;
  margin: 24rpx 32rpx 0;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  margin-bottom: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.section-desc {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.role-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.role-tab {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  background: #F3F4F6;
  color: #374151;
  transition: all 0.2s;
}

.role-tab.active {
  color: #FFFFFF;
  font-weight: 500;
}

.module-list {
  display: flex;
  flex-direction: column;
}

.module-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.module-item:last-child {
  border-bottom: none;
}

.module-icon {
  width: 72rpx;
  height: 72rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.module-info {
  flex: 1;
  min-width: 0;
}

.module-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}

.module-desc {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.module-switch {
  width: 88rpx;
  height: 52rpx;
  background: #D1D5DB;
  border-radius: 999rpx;
  padding: 4rpx;
  transition: background 0.2s;
  flex-shrink: 0;
}

.module-switch.on {
  background: #10B981;
}

.switch-dot {
  width: 44rpx;
  height: 44rpx;
  background: #FFFFFF;
  border-radius: 50%;
  transition: transform 0.2s;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.module-switch.on .switch-dot {
  transform: translateX(36rpx);
}

.perm-hint {
  background: #FFFBEB;
  border-radius: 12rpx;
  padding: 20rpx;
}

.hint-text {
  display: block;
  font-size: 24rpx;
  color: #92400E;
  line-height: 1.8;
}

.log-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 32rpx;
}

.summary-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-item.warn .summary-val {
  color: #F59E0B;
}

.summary-val {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.summary-lbl {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.summary-btn {
  padding: 20rpx 32rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.log-list {
  padding: 0 32rpx;
}

.log-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.log-time {
  width: 160rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  flex-shrink: 0;
  line-height: 1.6;
}

.log-content {
  flex: 1;
  min-width: 0;
}

.log-action-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.log-user {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.log-action {
  font-size: 26rpx;
  color: #374151;
}

.log-target, .log-ip {
  display: block;
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.6;
}

.log-risk {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
  height: fit-content;
}

.log-empty {
  text-align: center;
  padding: 80rpx 0;
}

.log-empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

.security-list {
  padding: 24rpx 32rpx;
}

.security-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.security-info {
  flex: 1;
  min-width: 0;
}

.security-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}

.security-desc {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.security-switch {
  width: 88rpx;
  height: 52rpx;
  background: #D1D5DB;
  border-radius: 999rpx;
  padding: 4rpx;
  transition: background 0.2s;
  flex-shrink: 0;
}

.security-switch.on {
  background: #10B981;
}

.security-switch.on .switch-dot {
  transform: translateX(36rpx);
}
