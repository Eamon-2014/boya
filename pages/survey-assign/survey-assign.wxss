.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 140rpx;
}

/* ===== 步骤指示器 ===== */
.stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 48rpx;
  background: #FFFFFF;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #9CA3AF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.step.active .step-circle {
  background: var(--color-primary);
  color: #FFFFFF;
}

.step.done .step-circle {
  background: #10B981;
  color: #FFFFFF;
}

.step-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.step.active .step-label {
  color: var(--color-primary);
  font-weight: 500;
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: #E5E7EB;
  margin: 0 16rpx;
  margin-bottom: 32rpx;
  transition: background 0.3s;
}

.step-line.active {
  background: #10B981;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  margin: 24rpx 32rpx;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.list-title {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
  padding: 0 32rpx;
  margin-bottom: 16rpx;
}

/* ===== 客户列表 ===== */
.customer-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.customer-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s;
}

.card-hover {
  transform: scale(0.98);
  opacity: 0.85;
}

.cust-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex-shrink: 0;
}

.cust-info {
  flex: 1;
  min-width: 0;
}

.cust-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.cust-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.cust-lang {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.cust-sub {
  font-size: 24rpx;
  color: #9CA3AF;
}

.cust-arrow {
  font-size: 36rpx;
  color: #D1D5DB;
}

/* ===== 已选客户栏 ===== */
.selected-customer-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #EFF6FF;
  margin: 24rpx 32rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #BFDBFE;
}

.sel-cust-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex-shrink: 0;
}

.sel-cust-avatar.sm {
  width: 64rpx;
  height: 64rpx;
  font-size: 26rpx;
}

.sel-cust-info {
  flex: 1;
  min-width: 0;
}

.sel-cust-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
}

.sel-cust-sub {
  font-size: 24rpx;
  color: #6B7280;
  display: block;
  margin-top: 2rpx;
}

.sel-cust-change {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 8rpx 16rpx;
}

/* ===== 模板列表 ===== */
.template-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.template-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s;
}

.tpl-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tpl-lang-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.tpl-category {
  font-size: 22rpx;
  color: #9CA3AF;
}

.tpl-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.tpl-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.tpl-meta {
  display: flex;
  gap: 24rpx;
}

.tpl-meta-item {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* ===== 配置区域 ===== */
.config-section {
  margin: 24rpx 32rpx 0;
}

.config-section-title {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.config-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tpl-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tpl-icon {
  font-size: 32rpx;
}

.config-label {
  font-size: 28rpx;
  color: #1F2937;
  flex: 1;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.picker-arrow {
  font-size: 32rpx;
  color: #D1D5DB;
}

.config-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 10rpx;
  padding-left: 8rpx;
}

/* ===== AI教师选择 ===== */
.ai-teacher-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-teacher-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.ai-teacher-card.selected {
  border-color: var(--color-primary);
  background: #EFF6FF;
}

.ai-avatar {
  width: 64rpx;
  height: 64rpx;
  background: #EDE9FE;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.ai-info {
  flex: 1;
  min-width: 0;
}

.ai-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
}

.ai-sub {
  font-size: 22rpx;
  color: #9CA3AF;
  display: block;
  margin-top: 2rpx;
}

.ai-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.ai-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

/* ===== 留言输入框 ===== */
.message-textarea {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  min-height: 160rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
  padding-right: 8rpx;
}

/* ===== 推送预览 ===== */
.preview-card {
  background: linear-gradient(135deg, #EFF6FF 0%, #F0FDF4 100%);
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx 32rpx 0;
  border: 2rpx solid #DBEAFE;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--color-primary-bg);
}

.preview-row:last-child {
  border-bottom: none;
}

.preview-key {
  font-size: 26rpx;
  color: #6B7280;
}

.preview-val {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
  text-align: right;
  max-width: 360rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.btn-cancel {
  padding: 24rpx 40rpx;
  background: #F3F4F6;
  color: #6B7280;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-back {
  padding: 24rpx 40rpx;
  background: #F3F4F6;
  color: #374151;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-submit {
  flex: 1;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--color-primary), #4F46E5);
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.btn-submit.disabled {
  opacity: 0.6;
}

/* ===== 空状态 ===== */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 28rpx;
  color: #9CA3AF;
}
