/* app.wxss - 全局样式 + 主题变量 */

/* ============ 主题变量（CSS自定义属性） ============ */
page {
  /* 品牌主题色 */
  --color-primary: #2563EB;
  --color-primary-light: #3B82F6;
  --color-primary-dark: #1D4ED8;
  --color-primary-gradient: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
  --color-primary-bg: rgba(37, 99, 235, 0.08);

  /* 辅助色 */
  --color-success: #10B981;
  --color-success-bg: rgba(16, 185, 129, 0.1);
  --color-warning: #F59E0B;
  --color-warning-bg: rgba(245, 158, 11, 0.1);
  --color-danger: #EF4444;
  --color-danger-bg: rgba(239, 68, 68, 0.1);
  --color-info: #3B82F6;
  --color-info-bg: rgba(59, 130, 246, 0.1);
  --color-ai: #8B5CF6;
  --color-ai-bg: rgba(139, 92, 246, 0.1);

  /* 背景色 */
  --color-bg-page: #F5F7FA;
  --color-bg-card: #FFFFFF;
  --color-bg-gray: #F3F4F6;
  --color-bg-hover: #F9FAFB;

  /* 文本色 */
  --color-text-primary: #1F2937;
  --color-text-secondary: #6B7280;
  --color-text-tertiary: #9CA3AF;
  --color-text-disabled: #D1D5DB;
  --color-text-white: #FFFFFF;

  /* 边框色 */
  --color-border: #E5E7EB;
  --color-border-light: #F3F4F6;

  /* 标签背景 */
  --color-tag-bg-blue: rgba(59, 130, 246, 0.1);
  --color-tag-bg-green: rgba(16, 185, 129, 0.1);
  --color-tag-bg-orange: rgba(245, 158, 11, 0.1);
  --color-tag-bg-purple: rgba(139, 92, 246, 0.1);
  --color-tag-bg-gray: rgba(156, 163, 175, 0.15);

  /* 间距系统（8px网格） */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-2xl: 64rpx;
  --spacing-3xl: 80rpx;

  /* 圆角 */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-button: 48rpx;
  --radius-round: 999rpx;

  /* 按钮高度 */
  --button-height-sm: 64rpx;
  --button-height-md: 80rpx;
  --button-height-lg: 96rpx;

  /* 字体大小 */
  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-base: 28rpx;
  --font-size-md: 30rpx;
  --font-size-lg: 34rpx;
  --font-size-xl: 40rpx;
  --font-size-2xl: 48rpx;

  /* 阴影 */
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-card-hover: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
  --shadow-float: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  --shadow-popup: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);

  /* 页面尺寸 */
  --page-padding: 32rpx;

  background-color: var(--color-bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

image {
  display: block;
}

/* ============ 通用工具类 ============ */
.page-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 0 var(--page-padding);
  padding-top: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-h-center {
  display: flex;
  justify-content: center;
}

.flex-v-center {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.flex-shrink-0 {
  flex-shrink: 0;
}

.flex-wrap {
  flex-wrap: wrap;
}

.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-base {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-lg);
}

/* 卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-md);
}

.card-title {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.card-action {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-xs);
  font-size: var(--font-size-xs);
  line-height: 1.2;
  white-space: nowrap;
  flex-shrink: 0;
}

.tag-primary {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

.tag-success {
  background: var(--color-success-bg);
  color: var(--color-success);
}

.tag-warning {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.tag-danger {
  background: var(--color-danger-bg);
  color: var(--color-danger);
}

.tag-info {
  background: var(--color-info-bg);
  color: var(--color-info);
}

.tag-ai {
  background: var(--color-ai-bg);
  color: var(--color-ai);
}

.tag-gray {
  background: var(--color-tag-bg-gray);
  color: var(--color-text-secondary);
}

.tag-rounded {
  border-radius: var(--radius-round);
  padding: 4rpx 16rpx;
}

/* 按钮 */
.btn {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  text-align: center;
  font-size: inherit;
  color: inherit;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--color-primary-gradient);
  color: var(--color-text-white);
  border-radius: var(--radius-button);
  height: var(--button-height-md);
  font-size: var(--font-size-base);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-outline {
  background: var(--color-bg-page);
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-button);
  height: var(--button-height-md);
  font-size: var(--font-size-base);
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-sm {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-round);
  font-size: var(--font-size-xs);
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: var(--spacing-xl) 0 var(--spacing-md);
}

.section-title {
  display: flex;
  align-items: center;
}

.section-title-bar {
  width: 6rpx;
  height: 28rpx;
  background: var(--color-primary-gradient);
  border-radius: var(--radius-xs);
  margin-right: var(--spacing-sm);
}

.section-title-text {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-action {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 空状态 */
.empty-state {
  padding: 80rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  background: var(--color-bg-gray);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  line-height: 1;
}

.empty-title {
  display: block;
  font-size: var(--font-size-md);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.empty-desc {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* 滚动容器 */
.scroll-x {
  white-space: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-border-light);
}
