.tab-bar {
  display: flex;
  height: 110rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #E5E7EB;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.tab-icon {
  font-size: 36rpx;
  line-height: 1;
  opacity: 0.6;
}
.tab-text {
  font-size: 22rpx;
  color: #9CA3AF;
}
.tab-item.active .tab-text {
  color: var(--color-primary);
  font-weight: 600;
}
.tab-item.active .tab-icon {
  opacity: 1;
}
